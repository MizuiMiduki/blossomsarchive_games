{
  "name": "blossomsarchive-games",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx tsx scripts/post-build.ts",
    "preview": "vite preview",
    "indexnow": "npx tsx scripts/notify-indexnow.ts",
    "audit:pagespeed": "npx tsx scripts/audit-lighthouse.ts",
    "type-check": "tsc --noEmit",
    "test": "node scripts/qa-test-suite.js && npx tsx tests/runner.ts",
    "test:all": "node scripts/qa-test-suite.js && npx tsx tests/runner.ts",
    "test:unit": "npx tsx tests/runner.ts --suite=unit",
    "test:integration": "npx tsx tests/runner.ts --suite=integration",
    "test:ui": "npx tsx tests/runner.ts --suite=ui",
    "test:e2e": "npx tsx tests/runner.ts --suite=e2e",
    "test:visual": "npx tsx tests/runner.ts --suite=visual",
    "test:perf": "npx tsx tests/runner.ts --suite=performance",
    "test:security": "npx tsx tests/runner.ts --suite=security"
  },
  "dependencies": {
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "solid-js": "^2.0.3",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^3.0.0-next.27"
  }
}
